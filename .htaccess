DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^produto\.huntersmotos\.com\.br$ [NC]
  RewriteRule ^ https://produto.huntersmotos.com.br%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-unHl0qxyT8hZlxvTM6YCpSnxU4f6UfAux3ULdB9v8T0=' 'sha256-2QVRzSHDY+Rz8wbvixqz6pTW9uokj7y+piaap/XCMCo=' 'sha256-qIA2vGUS2t+MYRCz8zH48nstXAxGkR33ry9mSvzJrJ8=' 'sha256-H7pzMfBqoZRqslLdePH61aP8y7jGDevYF7LLL4eYsh8=' 'sha256-pSBCwxWCCpjLxdDEeVR7SX8eIUtZutiHLz/snxHdYIA=' 'sha256-Qsg2aGQdqOh3WCUqg7btkPg/2yEjrYqLQObVT8uBZ/Y=' 'sha256-wy1udmys4ev2YfWvlSrVGhmL3upSvMOxbaYlRihLYYg=' https://www.googletagmanager.com https://tagmanager.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://www.youtube.com https://s.ytimg.com https://*.clarity.ms; script-src-elem 'self' 'sha256-unHl0qxyT8hZlxvTM6YCpSnxU4f6UfAux3ULdB9v8T0=' 'sha256-2QVRzSHDY+Rz8wbvixqz6pTW9uokj7y+piaap/XCMCo=' 'sha256-qIA2vGUS2t+MYRCz8zH48nstXAxGkR33ry9mSvzJrJ8=' 'sha256-H7pzMfBqoZRqslLdePH61aP8y7jGDevYF7LLL4eYsh8=' 'sha256-pSBCwxWCCpjLxdDEeVR7SX8eIUtZutiHLz/snxHdYIA=' 'sha256-Qsg2aGQdqOh3WCUqg7btkPg/2yEjrYqLQObVT8uBZ/Y=' 'sha256-wy1udmys4ev2YfWvlSrVGhmL3upSvMOxbaYlRihLYYg=' https://www.googletagmanager.com https://tagmanager.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://www.youtube.com https://s.ytimg.com https://*.clarity.ms; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com https://tagmanager.google.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://*.google.com https://www.google.com.br https://*.google-analytics.com https://*.g.doubleclick.net https://ssl.gstatic.com https://www.gstatic.com https://i.ytimg.com https://*.clarity.ms https://c.bing.com; connect-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://*.google.com https://www.google.com.br https://*.google-analytics.com https://*.g.doubleclick.net https://ad.doubleclick.net https://www.youtube.com https://*.clarity.ms https://c.bing.com; frame-src https://www.googletagmanager.com https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
